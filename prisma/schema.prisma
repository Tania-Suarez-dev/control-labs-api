generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String?    @map("password_hash") @db.Text
  nombre          String     @db.VarChar(150)
  rol             String     @db.VarChar(20)
  activo          Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  instructorLoans Loan[]     @relation("LoanInstructor")
  guardLoans      Loan[]     @relation("LoanGuard")
  incidents       Incident[] @relation("IncidentReporter")
  userRooms       UserRoom[]
  equipmentMovements EquipmentMovement[] @relation("EquipmentMovedBy")
  incidentComments IncidentComment[] @relation("IncidentCommentAuthor")

  @@map("users")
}

model Room {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String      @unique @db.VarChar(100)
  bloque       String      @db.VarChar(50)
  capacidadPcs Int         @map("capacidad_pcs")
  estado       String      @default("OPERATIVO") @db.VarChar(20)
  equipment    Equipment[]
  loans        Loan[]
  userRooms    UserRoom[]
  outgoingMovements EquipmentMovement[] @relation("MovementFromRoom")
  incomingMovements EquipmentMovement[] @relation("MovementToRoom")

  @@map("rooms")
}

model Equipment {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placaSena    String     @unique @map("placa_sena") @db.VarChar(50)
  codigoActivo String     @unique @map("codigo_activo") @db.VarChar(100)
  tipo         String     @db.VarChar(50)
  roomId       String     @map("room_id") @db.Uuid
  estado       String     @default("OPERATIVO") @db.VarChar(20)
  room         Room       @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  incidents    Incident[]
  movements    EquipmentMovement[] @relation("EquipmentMovements")

  @@index([roomId], map: "idx_equipment_room")
  @@map("equipment")
}

model Loan {
  id           BigInt    @id @default(autoincrement())
  roomId       String    @map("room_id") @db.Uuid
  instructorId String    @map("instructor_id") @db.Uuid
  guardaId     String    @map("guarda_id") @db.Uuid
  numeroPc     Int       @map("numero_pc")
  estado       String    @default("PENDIENTE_APROBACION") @db.VarChar(24)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  instructor   User      @relation("LoanInstructor", fields: [instructorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  guard        User      @relation("LoanGuard", fields: [guardaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([roomId, createdAt(sort: Desc)], map: "idx_loans_room_created")
  @@map("loans")
}

model Incident {
  id          BigInt    @id @default(autoincrement())
  equipmentId String    @map("equipment_id") @db.Uuid
  reportedBy  String    @map("reported_by") @db.Uuid
  descripcion String    @db.Text
  prioridad   String    @db.VarChar(10)
  estado      String    @default("PENDIENTE") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reporter    User      @relation("IncidentReporter", fields: [reportedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  comments    IncidentComment[]

  @@index([equipmentId, estado], map: "idx_incidents_equipment_status")
  @@map("incidents")
}

model UserRoom {
  userId String @map("user_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roomId])
  @@index([roomId], map: "idx_user_rooms_room")
  @@map("user_rooms")
}

model EquipmentMovement {
  id          BigInt    @id @default(autoincrement())
  equipmentId String    @map("equipment_id") @db.Uuid
  fromRoomId  String    @map("from_room_id") @db.Uuid
  toRoomId    String    @map("to_room_id") @db.Uuid
  movedBy     String    @map("moved_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  equipment   Equipment @relation("EquipmentMovements", fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromRoom    Room      @relation("MovementFromRoom", fields: [fromRoomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toRoom      Room      @relation("MovementToRoom", fields: [toRoomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mover       User      @relation("EquipmentMovedBy", fields: [movedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipmentId, createdAt(sort: Desc)], map: "idx_equipment_movements_equipment_created")
  @@map("equipment_movements")
}

model IncidentComment {
  id         BigInt   @id @default(autoincrement())
  incidentId BigInt   @map("incident_id")
  authorId   String   @map("author_id") @db.Uuid
  tipo       String   @default("COMENTARIO") @db.VarChar(16)
  contenido  String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author     User     @relation("IncidentCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([incidentId, createdAt(sort: Desc)], map: "idx_incident_comments_incident_created")
  @@map("incident_comments")
}
